# Obrigatória para cdk synth, diff e deploy.
CHUVA_BUDGET_EMAIL=

# Opcional: usuários IAM que também recebem o deny do kill switch, separados por vírgula.
CHUVA_KILL_SWITCH_USERS=

# Opcional: roles IAM, com caminho se houver, que também recebem o deny do kill switch.
# Deve estar definida em todo deploy da FoundationStack; sem ela, as roles saem do kill switch.
CHUVA_KILL_SWITCH_ROLES=managed/AccountFullAccessRole
